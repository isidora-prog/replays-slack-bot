# Slack Bot Configuration
# Copy this file to .env and fill in the values

# Slack App Bot Token (from https://api.slack.com/apps)
# Found under: OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-token-here

# Slack App Signing Secret (from https://api.slack.com/apps)
# Found under: Basic Information > Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret-here

# Anthropic API Key (from https://console.anthropic.com)
# Keep this secret! Use as environment variable in production
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Port for the server (default: 3000)
PORT=3000

# Optional: Google Drive Service Account (if using service account auth)
# Leave blank if using OAuth from the app
GOOGLE_DRIVE_SERVICE_ACCOUNT={}

# Optional: Environment (development or production)
NODE_ENV=development
